# bilicom 实验配置模板：复制为 .env 后填写（.env 已 gitignore）

# --- B 站 Cookie（可选；匿名可抓但缺 IP 属地/可能限流更早）---
# 从已登录浏览器复制完整 Cookie 头，至少包含 SESSDATA
BILIBILI_COOKIE=

# --- author_hash 盐（换盐会改变作者指纹；保持稳定以便跨视频比较）---
BILI_HASH_SALT=

# --- LLM（OpenAI-compatible；flash/mini 级模型即可完成 map 阶段）---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_LENGTH=32000

# --- AI Provider（推荐在网页「设置 → AI / NLP」配置，存于 data/webui/ai_settings.json；
#     此处为环境变量兜底。OpenAI-compatible：OpenAI/DeepSeek/GLM/Kimi/Ollama 等）---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b
